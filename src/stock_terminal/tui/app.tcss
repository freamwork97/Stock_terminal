Screen { layout: vertical; }
#filter { height: 3; }
#summary { height: auto; padding: 0 1; color: $text-muted; }
#panels { height: 1fr; }
WatchlistTable { width: 3fr; height: 1fr; border: round $accent; }
ChartPanel { width: 2fr; height: 1fr; border: round $accent; }
#panels.narrow { layout: vertical; }
#panels.narrow WatchlistTable { width: 1fr; height: 1fr; }
#panels.narrow ChartPanel { width: 1fr; height: 1fr; }
